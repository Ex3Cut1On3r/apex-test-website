# Required on Vercel for /admin authentication
APEX_ADMIN_EMAIL=admin@example.com
APEX_ADMIN_PASSWORD=replace-with-a-strong-password
APEX_ADMIN_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional; same-origin preview is used if omitted.
NEXT_PUBLIC_APEX_SITE_URL=

# Required on Vercel if Publish should commit CMS content back to this website repo.
GITHUB_TOKEN=
GITHUB_REPO=Ex3Cut1On3r/apex-test-website
GITHUB_BRANCH=main
GITHUB_CONTENT_PATH_EN=shared/content/en.json
GITHUB_CONTENT_PATH_AR=shared/content/ar.json
GITHUB_MEDIA_PATH=public/shared/assets/cms
